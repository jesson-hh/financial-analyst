# guanlan-v2 运行所需环境变量 —— 复制本文件为 .env (gitignore 之), 或在系统环境设置。
# 真实密钥不要写进仓库; 引擎运行时从 os.environ 读取。

# ── LLM key ───────────────────────────────────────────────
# config/llm.yaml 默认 provider = deepseek (api_key_env: DEEPSEEK_API_KEY)。
# 不设则 /models 不列 deepseek, /run 答案合成会 401。
DEEPSEEK_API_KEY=

# 可选: config/llm.yaml 里休眠的 provider, 设了对应 key 才会出现在 /models。
# DASHSCOPE_API_KEY=
# KIMI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# 国际模型默认使用系统网络与系统证书库。若部署环境把对应 provider 的
# network_profile 显式改为 intl_clash，可在此指定代理；TLS 校验默认开启。
# HTTPS_PROXY=http://127.0.0.1:7890
# FA_INTL_VERIFY=true

# 可选数据源凭据：
# TUSHARE_TOKEN=
# FA_TUSHARE_TOKEN=
# HUGGINGFACE_TOKEN=
# TDX_API_KEY=
# GUANLAN_MCP_BEARER_TOKEN=

# server.py 对 gitignored ``var/secrets.env`` 使用精确凭据白名单。该文件
# 只允许本节列出的 provider/API/MCP 凭据及下方三个 PIT HMAC 字段；未知项、
# 运行参数、feature gate 和 write gate 会拒绝加载并在只读状态中显形。
# GUANLAN_EVENTS_INGEST / GUANLAN_MCP_WRITE / GUANLAN_SERVER_BACKGROUND 等
# 必须由进程或部署环境显式提供，绝不能放进 var/secrets.env。

# ── 数据路径 (默认经 config/loaders.yaml → G:/stocks; 一般无需设) ──
# 见 docs/data_contract.md。覆盖时:
# FA_PARQUET_ROOT=G:/stocks/stock_data/parquet
# FA_NEWS_DATA_ROOT=G:/stocks/news_data
# FA_QLIB_URI=G:/stocks/stock_data/cn_data

# ── 引擎源 / 配置覆盖 (默认已指向仓库内 engine/ 与 config/, 一般无需设) ──
# GUANLAN_FA_SRC=G:/fa-watch-wt/src     # 指回上游引擎做 A/B
# FA_CONFIG_DIR=G:/guanlan-v2/config    # 显式锁定配置目录

# ── 严格 PIT 生产信任锚（历史研究；真实 secret 绝不入库）──────────
# 生产服务可从进程环境读取；本机 9999 守护链也会由 server.py 的精确
# 凭据白名单读取 gitignored 的 var/secrets.env。不要把密钥直接写进
# check_9999.ps1。
# GL_PIT_HMAC_KEY_ID=pit-prod-2026-01       # 公开的 active key id
# GL_PIT_HMAC_KEY=base64:<至少32字节随机密钥的base64>
# GL_PIT_HMAC_VERIFY_KEYS={}                # 轮换旧钥 JSON；暂无旧钥也要显式 {}
# 以下是部署时完成 OS NTP 检查后的短期运行声明，不是 secret，也不会从
# var/secrets.env 加载；必须由进程/服务管理器的部署环境提供：
# GL_PIT_NTP_STATUS=synchronized
# GL_PIT_NTP_SOURCE=w32time
# GL_PIT_NTP_CHECKED_AT=2026-09-03T12:00:00+08:00
# GL_PIT_NTP_MAX_AGE_SECONDS=86400           # 允许 60..604800，默认 24 小时

# ── 服务监听 (默认 127.0.0.1:9999) ──
# GUANLAN_HOST=127.0.0.1
# GUANLAN_PORT=9999
